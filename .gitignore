node_modules/
dist/
coverage/
.DS_Store
.env
.env.*
!.env.example
*.pem
*.key

# UX design: keep third-party reference imagery (e.g. OB64 screenshots) LOCAL —
# copyrighted, and this repo is public. Design docs + original mockups commit; refs don't.
docs/planning-artifacts/ux-designs/*/imports/
.DS_Store

# High-res art masters (source for downscaled sprite tiles; not shipped)
/art-src/

# Raw Midjourney batches + OB64 reference art — local ONLY, never published.
# The ob64/ sub-tree is Atlus-copyright; the parent holds ~1GB of raw generations
# whose WINNERS are copied into ux-designs/midjourney/selected/ (tracked). Ignoring
# only the sub-folder left the parent stageable by `git add -A` in a PUBLIC repo
# (story 5.2 code review — it already nearly happened once).
docs/planning-artifacts/ux-designs/ui/

# Same rule for the other batch folder: raw Midjourney generations land in
# ux-designs/midjourney/ and the WINNERS are copied into midjourney/selected/
# (tracked, and what the app ships from). Ignore the raw drops, keep selected/.
# Four early raw files are already tracked from before this rule — gitignore
# does not untrack, so they stay until deliberately removed.
docs/planning-artifacts/ux-designs/midjourney/*
!docs/planning-artifacts/ux-designs/midjourney/selected/
